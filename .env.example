# Copy this file to .env and fill in real values.
# Never commit .env. In GitHub Actions, set these as repository secrets.

# Postgres owner connection (Neon, direct, no -pooler). Used ONLY by the migration runner.
DATABASE_URL=postgresql://neondb_owner:password@host/neondb?sslmode=require

# Limited logins. Written automatically by: uv run python migrations/logins.py --env-file .env
AGENT_DATABASE_URL=postgresql://kidnews_agent:password@host/neondb?sslmode=require
ADMIN_DATABASE_URL=postgresql://kidnews_admin:password@host/neondb?sslmode=require
PUBLISH_DATABASE_URL=postgresql://kidnews_publish:password@host/neondb?sslmode=require

# Claude API
ANTHROPIC_API_KEY=your-api-key-here
# Model in litellm format: provider/model. Change this to switch providers.
LLM_MODEL=anthropic/claude-haiku-5-5

# Cost guardrail: stop the job if today's model spend passes this (USD)
DAILY_SPEND_CAP_USD=0.25

# Source feed (verify the official NASA Earth Observatory feed URL)
NASA_EO_FEED_URL=

# Static site output folder
SITE_OUTPUT_DIR=web/dist
